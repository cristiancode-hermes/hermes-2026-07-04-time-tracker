# Server
PORT=3000
NODE_ENV=development

# Database (SQLite for dev)
DATABASE_PATH=data/timetracker.db

# JWT
JWT_SECRET=change-this-to-a-random-secret

# Neon/PostgreSQL (for production)
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/timetracker

# Neon Data API (optional, for direct frontend reads)
NEON_API_KEY=
NEON_PROJECT_ID=

# AI (future use)
OPENAI_API_KEY=
